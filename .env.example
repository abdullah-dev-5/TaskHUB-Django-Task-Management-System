DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True


# Supabase PostgreSQL connection. These DB_* variables take priority.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_SSLMODE=require

# Optional alternative connection-string configuration.
# DATABASE_URL=postgresql://postgres:replace-me@db.your-project.supabase.co:5432/postgres

# Optional Supabase Storage configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-me
SUPABASE_BUCKET=task-attachments
SUPABASE_PUBLIC_URL=
