DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True


# Set DB_NAME to activate PostgreSQL. Leave it empty for the SQLite learning fallback.
DB_NAME=taskhub
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Optional Supabase Storage configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-me
SUPABASE_BUCKET=task-attachments
SUPABASE_PUBLIC_URL=
