DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True


# Use one PostgreSQL configuration method. DATABASE_URL is convenient for Supabase.
DATABASE_URL=postgresql://postgres:replace-me@db.your-project.supabase.co:5432/postgres

# Or set the individual PostgreSQL variables below.
DB_NAME=taskhub
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=db.your-project.supabase.co
DB_PORT=5432

# Optional Supabase Storage configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-me
SUPABASE_BUCKET=task-attachments
SUPABASE_PUBLIC_URL=
